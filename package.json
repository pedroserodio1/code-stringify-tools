{
  "name": "code-stringify-tools",
  "displayName": "Code Stringify Tools",
  "description": "Convert selected code to escaped string and back.",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/pedroserodio1/code-stringify-tools"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
    "keywords": [
    "stringify",
    "json",
    "escape",
    "code",
    "convert",
    "utility"
  ],
  "publisher": "PedroSerodio",
  "activationEvents": [],
  "main": "./dist/extension.js",
"contributes": {
    "commands": [
      {
        "command": "codeStringify.stringifyReplace",
        "title": "Stringify: Replace Selection"
      },
      {
        "command": "codeStringify.stringifyCopy",
        "title": "Stringify: Copy"
      },
      {
        "command": "codeStringify.destringifyReplace",
        "title": "Destringify: Replace Selection"
      },
      {
        "command": "codeStringify.destringifyCopy",
        "title": "Destringify: Copy"
      }
    ],

    "submenus": [
      {
        "id": "codeStringify.submenu",
        "label": "Stringify Tools"
      }
    ],

    "menus": {
      "editor/context": [
        {
          "submenu": "codeStringify.submenu",
          "group": "navigation"
        }
      ],
      "codeStringify.submenu": [
        {
          "command": "codeStringify.stringifyReplace",
          "group": "1_stringify"
        },
        {
          "command": "codeStringify.stringifyCopy",
          "group": "1_stringify"
        },
        {
          "command": "codeStringify.destringifyReplace",
          "group": "2_destringify"
        },
        {
          "command": "codeStringify.destringifyCopy",
          "group": "2_destringify"
        }
      ]
    },

    "keybindings": [
      {
        "command": "codeStringify.stringifyCopy",
        "key": "ctrl+alt+c",
        "when": "editorTextFocus && editorHasSelection"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "publish": "npm version patch && vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
